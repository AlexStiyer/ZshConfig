############################################################
# Alex's ZSH Config Harness
#
# NOTE: THIS IS NOT A PROMPT! This is the harness I use for my themes
#
# There are some TODOs sprinkled about for configuring this for different machines
#
# It includes:
#   - Async git status using zle callbacks and process substitution
#   - Stale prompt update when window is re-focused (only supported in terminals which send key code on focus in/out_
#   - Git Porcelain Parser (with a symbol bar)
#   - Mac OS Battery Level
#   - Search history keybinds
#
# Requirements:
#   - ZSH duh
#   - Zap plugin manager (https://github.com/zap-zsh)
#   - For a fast git prompt: git config --global core.untrackedCache true
#
# Git Symbols:
#   ◁  = unstaged changes
#   ▶  = staged changes
#   !  = untracked files
#   +N = commits ahead of upstream
#   -N = commits behind upstrea
#
# Provided VARS:
#   BATTERY      "85"
#   GIT_PROMPT   "+3/-1 main" (empty outside a repo, commit hash for detached)
#   GIT_SYMBOLS  "◁▶!"
############################################################


### Plugins
# supercharge runs compinit and sets history/completion options.
# syntax-highlighting must load before history-substring-search.

[[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/zap/zap.zsh" ]] &&
    source "${XDG_DATA_HOME:-$HOME/.local/share}/zap/zap.zsh"

plug "zsh-users/zsh-autosuggestions"
plug "zap-zsh/supercharge"
plug "zsh-users/zsh-syntax-highlighting"
plug "zsh-users/zsh-history-substring-search"


### Options and keybinds

setopt prompt_subst
export ZSHRC=~/.zshrc    # used by supercharge's Ctrl-X reload

# Up/down search history (normal and application cursor-key modes)
bindkey '^[[A' history-substring-search-up
bindkey '^[OA' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^[OB' history-substring-search-down


### Aliases and directories

alias reload='source ~/.zshrc'

#TODO: Where do you store your git files?
alias gs='cd ~/src'

# `src got/ironbank` -> cd ~/src/got/ironbank, with tab completion
src()  { cd ~/src/${1:-} }
_src() { _files -W ~/src -/ }
compdef _src src

hash -d src=~/src    # ~src works in any command


############################################################
# Git status
#
# git runs in the background so the prompt draws immediately;
# the prompt redraws once its output arrives. Sets:
#   GIT_PROMPT   "+3/-1 main"
#   GIT_SYMBOLS  "◁▶!"
############################################################

typeset -g GIT_PROMPT GIT_SYMBOLS GIT_PROMPT_FD GIT_PROMPT_DIR

git_prompt_clear() {
    GIT_PROMPT="" GIT_SYMBOLS=""
}

# Reads `git status --porcelain=v2 --branch` output.
git_prompt_parse() {
    git_prompt_clear

    local line oid branch ahead_behind
    local -i staged=0 unstaged=0 untracked=0 ahead=0 behind=0

    while IFS= read -r line; do
        case $line in
            '# branch.oid '*)  oid=${line#'# branch.oid '} ;;
            '# branch.head '*) branch=${line#'# branch.head '} ;;
            '# branch.ab '*)
                [[ $line =~ '\+([0-9]+) -([0-9]+)$' ]] && ahead=$match[1] behind=$match[2]
                ;;
            [12]' '*)    # changed file: characters 3-4 are the index/worktree state
                [[ ${line[3]} != . ]] && staged=1
                [[ ${line[4]} != . ]] && unstaged=1
                ;;
            'u '*) staged=1 unstaged=1 ;;
            '? '*) untracked=1 ;;
        esac
    done

    [[ -z $branch ]] && return    # not in a repo
    [[ $branch == '(detached)' ]] && branch=${oid[1,7]}

    (( ahead ))  && ahead_behind="+$ahead"
    (( behind )) && ahead_behind+="${ahead_behind:+/}-$behind"
    GIT_PROMPT="${ahead_behind:+$ahead_behind }$branch"

    (( unstaged ))  && GIT_SYMBOLS+='◁'
    (( staged ))    && GIT_SYMBOLS+='▶'
    (( untracked )) && GIT_SYMBOLS+='!'
}

git_prompt_start() {
    # Cancel a job still running from the previous prompt.
    if [[ -n $GIT_PROMPT_FD ]]; then
        zle -F $GIT_PROMPT_FD
        exec {GIT_PROMPT_FD}<&-
        GIT_PROMPT_FD=
    fi

    # Don't show the previous repo's status while waiting.
    if [[ $PWD != $GIT_PROMPT_DIR ]]; then
        git_prompt_clear
        GIT_PROMPT_DIR=$PWD
    fi

    # Only run git when there's a .git somewhere up the tree.
    local dir=$PWD
    while [[ -z $GIT_DIR && ! -e $dir/.git ]]; do
        [[ $dir == / ]] && { git_prompt_clear; return }
        dir=${dir:h}
    done

    exec {GIT_PROMPT_FD}< <(git --no-optional-locks status --porcelain=v2 --branch 2>/dev/null)
    zle -F -w $GIT_PROMPT_FD git_prompt_done
}

git_prompt_done() {
    zle -F $GIT_PROMPT_FD
    git_prompt_parse <&$GIT_PROMPT_FD
    exec {GIT_PROMPT_FD}<&-
    GIT_PROMPT_FD=
    theme_prompt
    zle reset-prompt
}
zle -N git_prompt_done


############################################################
# Prompt
############################################################


#TODO: Define the prompt here
#  Escape the branch name before putting it in PS1, as
#  '${GIT_PROMPT//\%/%%}', so prompt_subst never runs it as code.

zmodload zsh/datetime
typeset -i BATTERY_CHECKED=0

prompt_precmd() {
    # Battery changes slowly; check at most once a minute.
    if (( EPOCHSECONDS - BATTERY_CHECKED >= 60 )); then
        [[ $(pmset -g batt) =~ '([0-9]+)%' ]] && BATTERY=$match[1]
        BATTERY_CHECKED=$EPOCHSECONDS
    fi

    git_prompt_start
    theme_prompt
}

autoload -Uz add-zsh-hook
add-zsh-hook precmd prompt_precmd

# Refresh the prompt when the terminal window regains focus. Focus
# reporting is only on at the prompt, so other programs never see it.
focus_reporting_on()  { printf '\e[?1004h' }
focus_reporting_off() { printf '\e[?1004l' }
add-zsh-hook precmd  focus_reporting_on
add-zsh-hook preexec focus_reporting_off

prompt_focus_in() {
    prompt_precmd
    zle reset-prompt
}
zle -N prompt_focus_in
bindkey '\e[I' prompt_focus_in    # focus gained
bindkey '\e[O' redisplay         # focus lost: nothing to do


### Homebrew
export PATH="/opt/homebrew/bin:$PATH"

### Work Aliases + Config 
[[ -f ~/.zshrc_[YOUR_COMPANY_NAME] ]] && source ~/.zshrc_[YOUR_COMPANY_NAME]
